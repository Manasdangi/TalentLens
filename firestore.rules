rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isRecruiter() {
      return request.auth != null &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.userType == 'recruiter';
    }

    // Resumes collection - one resume per document.
    // Users manage their own resumes; recruiters can read individual resume docs
    // for candidate ranking/application review.
    match /Resumes/{resumeId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (isRecruiter() && resource.data.keys().hasAll(['id', 'content']))
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Users collection - users can read/write their own profile
    match /Users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public login-page presence count. Documents contain only ephemeral
    // session IDs and timestamps so the login screen can show active viewers.
    match /LoginPageViewers/{viewerId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly([
          'sessionId',
          'page',
          'lastSeenAt',
          'createdAt'
        ]) &&
        request.resource.data.sessionId == viewerId &&
        request.resource.data.page == 'candidate-login' &&
        request.resource.data.lastSeenAt == request.time &&
        request.resource.data.createdAt == request.time;
      allow delete: if resource.data.sessionId == viewerId;
    }

    // Public append-only login-page viewer history for all-time unique counts.
    match /LoginPageAllTimeViewers/{viewerId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'viewerId',
          'page',
          'firstSeenAt'
        ]) &&
        request.resource.data.viewerId == viewerId &&
        request.resource.data.page == 'candidate-login' &&
        request.resource.data.firstSeenAt == request.time;
      allow update, delete: if false;
    }
    
    // JobOpportunities collection
    match /JobOpportunities/{jobId} {
      // Anyone can read active job opportunities
      allow read: if request.auth != null && resource.data.isActive == true;
      // Recruiters can create their own job opportunities
      allow create: if request.auth != null && request.resource.data.recruiterId == request.auth.uid;
      // Only the recruiter who created it can update/delete
      allow update, delete: if request.auth != null && resource.data.recruiterId == request.auth.uid;
    }

    // JobApplications - candidates apply for jobs; recruiters read applications for their jobs
    match /JobApplications/{applicationId} {
      allow create: if request.auth != null && request.resource.data.candidateId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.candidateId == request.auth.uid ||
        get(/databases/$(database)/documents/JobOpportunities/$(resource.data.jobId)).data.recruiterId == request.auth.uid
      );
      allow update, delete: if false;
    }

    // ResumeByRole: resumes indexed by role doc (e.g. ResumeByRole/frontend/resumes/{resumeId})
    // Candidates write their own lightweight index docs; recruiters can read all
    // index docs and fetch the source resume document by resumeId when needed.
    match /ResumeByRole/{roleId}/resumes/{resumeId} {
      allow read: if isRecruiter();
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Portfolios: the document id is the public link (/p/{slug}), so ids are unique by design.
    // Anyone (signed in or not) can read a published portfolio; owners can read and edit theirs.
    // Keep the reserved list in sync with RESERVED_SLUGS in api/_lib/profile.ts.
    function isValidPortfolioSlug(slug) {
      return slug.matches('^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$') && !(slug in [
        'admin', 'api', 'app', 'assets', 'auth', 'dashboard', 'help', 'jobs', 'login', 'logout',
        'p', 'portfolio', 'recruiter', 'settings', 'signup', 'support', 'talentlens', 'www'
      ]);
    }

    function isValidPortfolio(slug) {
      let data = request.resource.data;
      return data.userId == request.auth.uid &&
        data.slug == slug &&
        data.published is bool &&
        data.profileJson is string && data.profileJson.size() < 200000 &&
        data.keys().hasOnly(['slug', 'userId', 'name', 'theme', 'accent', 'profileJson', 'published',
          'showVerified', 'createdAt', 'updatedAt']);
    }

    match /Portfolios/{slug} {
      // get: a missing document is readable so the editor can check whether a link is free.
      allow get: if resource == null || resource.data.published == true ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow list: if resource.data.published == true ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && isValidPortfolioSlug(slug) && isValidPortfolio(slug);
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && isValidPortfolio(slug);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // VerifiedProfiles/{uid}: GitHub/LeetCode stats written only by the verify-profile function
    // (service account, which bypasses these rules). Public so portfolios and recruiters can show badges.
    match /VerifiedProfiles/{userId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
