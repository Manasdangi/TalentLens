# Frontend Sentry
# Leave blank locally to disable Sentry.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1

# Optional. Leave blank to call same-origin /api (Vercel functions in production,
# proxied to the local Express backend in development). Set only to use another backend.
VITE_API_URL=
